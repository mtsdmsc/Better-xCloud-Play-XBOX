.bx-controller-customizations-container {
    .bx-btn-detect {
        display: block;
        margin-bottom: 20px;

        &.bx-monospaced {
            background: none;
            font-weight: bold;
            font-size: 12px;
        }
    }

    .bx-buttons-grid {
        display: grid;
        grid-template-columns: auto auto;
        column-gap: 20px;
        row-gap: 10px;
        margin-bottom: 20px;
    }

}

.bx-gp-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 30px;
    padding: 0 7px;
    border-radius: 7px;
    background: #2b2f36;
    border: 1px solid #5a606b;
    color: #fff;
    font-family: var(--bx-normal-font);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.2px;
    cursor: help;
    user-select: none;
    box-sizing: border-box;

    &[data-btn="A"] {
        border-radius: 50%;
        width: 30px;
        min-width: 30px;
        background: #107c10;
        border-color: #2bc22b;
    }

    &[data-btn="B"] {
        border-radius: 50%;
        width: 30px;
        min-width: 30px;
        background: #b91c1c;
        border-color: #ef4444;
    }

    &[data-btn="X"] {
        border-radius: 50%;
        width: 30px;
        min-width: 30px;
        background: #1d4ed8;
        border-color: #60a5fa;
    }

    &[data-btn="Y"] {
        border-radius: 50%;
        width: 30px;
        min-width: 30px;
        background: #ca8a04;
        border-color: #facc15;
        color: #111;
    }

    &[data-btn="Xbox"] {
        background: #14532d;
        border-color: #22c55e;
        font-size: 11px;
    }
}

.bx-gp-plus {
    font-family: var(--bx-normal-font);
    font-size: 13px;
    font-weight: 700;
    color: #9ca3af;
    margin: 0 4px;
}

.bx-controller-key-row {
    display: flex;
    align-items: stretch;

    > label {
        margin-bottom: 0;
        font-family: var(--bx-normal-font);
        font-size: 15px;
        text-align: center;
        min-width: 68px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        align-self: center;

        &::after {
            content: '❯';
            margin: 0 10px;
            font-size: 14px;
            align-self: center;
            color: #9ca3af;
        }
    }

    .bx-select {
        width: 100% !important;

        > div {
            min-width: 50px;
        }

        label {
            font-family: var(--bx-normal-font);
            font-size: 16px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 6px;
            height: 40px;
            line-height: 40px;
        }
    }

    &:hover {
        > label {
            .bx-gp-badge {
                box-shadow: 0 0 0 2px #ffe64b;
            }

            &::after {
                color: #fff;
            }
        }
    }
}

.bx-controller-customization-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 10px;

    span {
        font-family: var(--bx-normal-font);
        font-size: 13px;
        font-weight: 700;
        border-radius: 6px;
        background: #131313;
        color: #fff;
        display: inline-block;
        padding: 4px 6px;
        text-align: center;
    }
}
